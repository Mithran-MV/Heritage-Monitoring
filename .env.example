# ---------------------------------------------------------------------------
# Device ingest authentication
# ---------------------------------------------------------------------------
# Shared secret every sensor node must send as `X-API-Key` when POSTing a
# reading. Without it the ingest endpoint is an open write to your database.
# Generate one with:  openssl rand -hex 32
DEVICE_API_KEY=change_me_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Path to the SQLite file. Anything outside the project works too — point this
# at a mounted volume in Docker, or at /data on a Raspberry Pi.
DATABASE_PATH=./data/heritage.db

# Optional. Absolute URL of the deployment, used for OpenGraph and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
